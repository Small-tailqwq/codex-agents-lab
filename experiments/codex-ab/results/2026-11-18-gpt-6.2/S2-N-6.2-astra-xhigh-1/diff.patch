 class SearchTest(unittest.TestCase):
     def test_finds_substring(self):
         self.assertEqual([note["id"] for note in query.search(NOTES, "release")], [2])
 
+    def test_ignores_case_in_text_and_keyword(self):
+        notes = [{"text": "Milk for the cat"}, {"text": "buy milk"}, {"text": "buy tea"}]
+        self.assertEqual(query.search(notes, "mILk"), notes[:2])
+
 
 if __name__ == "__main__":
     unittest.main()
